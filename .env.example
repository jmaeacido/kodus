# Database credentials
DB_HOST=127.0.0.1
DB_USERNAME=root
DB_PASSWORD=
DB_NAME=kodus_db

# Full public URL for this app.
# Example:
# APP_URL=https://caraga-kodus-dev.dswd.gov.ph/
APP_URL=https://caraga-kodus-dev.dswd.gov.ph/

# Public root path where the app is mounted.
# Examples:
# APP_PUBLIC_ROOT=/
# APP_PUBLIC_ROOT=/internal/apps/kodus/
APP_PUBLIC_ROOT=/

# Application timezone used by PHP, MySQL sessions, and displayed app times.
APP_TIMEZONE=Asia/Manila

# URL prefix before the app directory when the app is deployed inside a nested path
# and APP_PUBLIC_ROOT is not set.
# Examples:
# APP_BASE_PATH=/
# APP_BASE_PATH=/internal/apps/
APP_BASE_PATH=/

# Optional public URL segment when the deployment folder name differs from the browser
# path. Leave unset when the app is served directly from the web root.
# APP_PUBLIC_DIRECTORY=kodus

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME="KODUS Admin"
SMTP_FROM_ADDRESS=your-email@example.com

# Caraga Connect SSO
CC_OAUTH_CLIENT_ID=
CC_OAUTH_AUTHORIZE_URL=
CC_OAUTH_TOKEN_URL=
CC_OAUTH_USERINFO_URL=
CC_OAUTH_LOGOUT_URL=
CC_OAUTH_LOGOUT_ALL_URL=
CC_OAUTH_REDIRECT_URI=
CC_OAUTH_SECRET=
CC_OAUTH_SCOPE=basic
CC_OAUTH_VERIFY_SSL=false

# Optional socket bridge
KODUS_SOCKET_ENABLED=false
KODUS_SOCKET_SERVER_URL=
KODUS_SOCKET_BROADCAST_URL=
KODUS_SOCKET_CLIENT_SCRIPT_URL=
KODUS_SOCKET_JOIN_EVENT=subscribe
KODUS_SOCKET_BEARER_TOKEN=
SOCKET_BEARER_TOKEN=

# Optional KODA scene system
# Modes: auto, weather, manual
KODA_SCENE_MODE=auto
KODA_SCENE_OVERRIDE=
KODA_EXPRESSION_OVERRIDE=
KODA_WEATHER_LATITUDE=
KODA_WEATHER_LONGITUDE=
KODA_WEATHER_CACHE_TTL=1800
